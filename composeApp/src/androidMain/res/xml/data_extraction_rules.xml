<?xml version="1.0" encoding="utf-8"?>
<!-- The budget holds financial data, so it isn't copied by cloud backup or device transfer.
     It comes back from the sync file (OneDrive, Google Drive or Dropbox) on a new phone. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
